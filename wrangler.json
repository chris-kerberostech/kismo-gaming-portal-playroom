		"NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "kismo-app.firebaseapp.com",
		"NEXT_PUBLIC_FIREBASE_PROJECT_ID": "kismo-app",
		"NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET": "kismo-app.firebasestorage.app",
